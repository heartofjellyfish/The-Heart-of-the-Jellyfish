# Copy to .env.local for local work; set the same names in Vercel for production.
# With NEXT_PUBLIC_POSTHOG_KEY unset the site behaves exactly as if there were no
# analytics in it — no requests, no console noise. See ANALYTICS.md.

# PostHog project API key (Project settings → Project API key). Public by design.
NEXT_PUBLIC_POSTHOG_KEY=

# Only for the toolbar and "view in PostHog" links — NOT where events go.
# https://eu.posthog.com on an EU project.
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Read by next.config.mjs at BUILD time to aim the /ingest rewrite. `us` or `eu`,
# and it has to agree with NEXT_PUBLIC_POSTHOG_UI_HOST above.
POSTHOG_REGION=us

# The mailing list. Server-side only — never reaches the browser. See
# app/api/subscribe/route.ts.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# The guestbook's store — screen three. Upstash Redis over its REST API, so
# there is no client library and this is just a URL and a bearer token; both are
# on the database's page in the Upstash console under "REST API". Server-side
# only. With them unset the store falls back to process memory, which is fine on
# a laptop and NOT a production mode — every serverless instance would keep its
# own wall, and the composer says so on screen. See lib/guestbook-store.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The undo. Enables DELETE /api/guestbook?id=… , sent as an x-guestbook-token
# header. Nothing on the wall is reviewed before it appears, so this is the only
# way to take something down. Unset, that route 404s rather than admitting it
# exists. Any long random string: openssl rand -hex 32
GUESTBOOK_ADMIN_TOKEN=

# Salts the hashed IP the guestbook rate-limits on, so the one piece of personal
# data the feature touches is not recoverable from a Redis key. openssl rand -hex 16
GUESTBOOK_SALT=
