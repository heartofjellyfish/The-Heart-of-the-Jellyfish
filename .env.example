# Copy to .env.local for local work; set the same names in Vercel for production.
# With NEXT_PUBLIC_POSTHOG_KEY unset the site behaves exactly as if there were no
# analytics in it — no requests, no console noise. See ANALYTICS.md.

# PostHog project API key (Project settings → Project API key). Public by design.
NEXT_PUBLIC_POSTHOG_KEY=

# Only for the toolbar and "view in PostHog" links — NOT where events go.
# https://eu.posthog.com on an EU project.
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Read by next.config.mjs at BUILD time to aim the /ingest rewrite. `us` or `eu`,
# and it has to agree with NEXT_PUBLIC_POSTHOG_UI_HOST above.
POSTHOG_REGION=us

# The mailing list. Server-side only — never reaches the browser. See
# app/api/subscribe/route.ts.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
